# Copy to .env locally and DO NOT commit actual values.
APP_ENV=development
LOG_LEVEL=INFO
# Development default database: SQLite file. Postgres: postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite:///agentic_local.sqlite3
# Generate a random 32+ character secret for stable sessions; REQUIRED in production.
SESSION_SECRET=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Trading remains unavailable; never put brokerage credentials in a public repository.

# S2 private provider data storage; never commit actual historical files
DATA_STORAGE_DIR=./data_store

# Sprint 12: OPTIONAL read-only Alpaca paper account snapshot in the BACKEND runtime.
# GitHub Actions repository secrets are NOT automatically injected into the running API.
# Never commit actual credentials or include them in the browser/frontend.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# Strongly recommended: pin this backend to the intended paper account ID.
ALPACA_PAPER_EXPECTED_ACCOUNT_ID=

# ATL XAU/USD historical paired BID/ASK feeds (read-only, default OFF).
# Use these only after reviewing source terms for PRIVATE storage / ML research.
# A practice token is required for OANDA. Never use a live OANDA token here.
OANDA_V20_PRACTICE_TOKEN=
ATL_OANDA_PRACTICE_RESEARCH=0
# Dukascopy stores raw M1 BID + ASK archives under DATA_STORAGE_DIR,
# independently of the public GitHub checkout.
ATL_DUKASCOPY_RESEARCH_DOWNLOAD=0
# With both sources enabled, independently check overlapping midpoint closes.
ATL_XAU_CROSSCHECK=0

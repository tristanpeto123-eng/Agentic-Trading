# Copy to .env locally and DO NOT commit actual values.
APP_ENV=development
LOG_LEVEL=INFO
# Development default database: SQLite file. Postgres: postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite:///agentic_local.sqlite3
# Generate a random 32+ character secret for stable sessions; REQUIRED in production.
SESSION_SECRET=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Trading remains unavailable; never put brokerage credentials in a public repository.
